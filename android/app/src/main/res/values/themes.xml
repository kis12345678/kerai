<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform Material theme, not AppCompat: the app pulls in no AndroidX dependencies.
         The dark background matches the web app's own ink colour so there is no white flash
         while the WebView loads. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
    </style>
</resources>
