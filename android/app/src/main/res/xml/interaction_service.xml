<?xml version="1.0" encoding="utf-8"?>
<!-- Declares Kerai as an assistant candidate. sessionService is what draws/launches the
     assistant on invocation; recognitionService is required by the framework even though Kerai
     recognises speech elsewhere. supportsAssist enables the assist gesture; the keyguard flag
     lets it be summoned from the lock screen. -->
<voice-interaction-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:sessionService="com.kerai.omniai.assistant.AssistantSessionService"
    android:recognitionService="com.kerai.omniai.assistant.AssistantRecognitionService"
    android:supportsAssist="true"
    android:supportsLaunchVoiceAssistFromKeyguard="true" />
