        <!-- ============ STATE ON DISK ============ -->
        <mxCell id="stateBox" value="STATE ON DISK — .omniai/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#8a6d1f;dashed=1;" vertex="1" parent="1">
