        </mxCell>
        <mxCell id="g1" value="PLANNER&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#666666&quot;&gt;decompose before acting; the loop&lt;br&gt;is still reactive, one call at a time&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;dashed=1;" vertex="1" parent="1">
