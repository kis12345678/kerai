<mxfile host="app.diagrams.net" agent="Kerai AI architecture" version="24.0.0">
  <diagram name="Kerai AI — how a turn works" id="kerai-turn">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="KERAI — one turn, end to end" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Boxes name the file that does the work. The permission gate, the executor and the critic are the three things standing between a model&#39;s intention and your machine." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="42" width="1100" height="20" as="geometry" />
        </mxCell>

        <!-- ============ INPUT ============ -->
        <mxCell id="inputBox" value="INPUT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#b0c4de;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#4a6785;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="230" height="220" as="geometry" />
        </mxCell>
        <mxCell id="inChat" value="Chat panel&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#666666&quot;&gt;components/chat-panel.tsx&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="120" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="inVoice" value="Voice — wake word → STT&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#666666&quot;&gt;lib/use-speech.ts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="180" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="inGest" value="Gestures (MediaPipe)&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#666666&quot;&gt;lib/use-gesture.ts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="240" width="200" height="45" as="geometry" />
        </mxCell>

        <!-- ============ PIPELINE ============ -->
        <mxCell id="p1" value="POST /api/chat&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#666666&quot;&gt;app/api/chat/route.ts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="120" width="260" height="45" as="geometry" />
        </mxCell>

        <mxCell id="p2" value="Fit the context window&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#666666&quot;&gt;compactMessages — history-compaction.ts&lt;br&gt;dropped span becomes a digest, not deleted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="195" width="260" height="55" as="geometry" />
        </mxCell>

        <mxCell id="p3" value="ROUTE — pick the specialist&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#666666&quot;&gt;routeTask — lib/agent-router.ts&lt;br&gt;1 explicit → 2 keyword score → 3 model (8s cap)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="280" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p4" value="Jarvis  ·  Friday  ·  Ultron&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#666666&quot;&gt;toolsForAgent — lib/agents.ts&lt;br&gt;each gets only its own tools&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="370" width="260" height="55" as="geometry" />
        </mxCell>

        <mxCell id="p5" value="PERMISSION&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#7a4a00&quot;&gt;buildToolApproval — lib/tool-risk.ts&lt;br&gt;safe · approve · deny · unclassified ⇒ approve&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="380" y="455" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p6" value="EXECUTOR&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#666666&quot;&gt;streamText tool loop, ≤ 20 steps&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="560" width="260" height="55" as="geometry" />
        </mxCell>

        <mxCell id="p7" value="VERIFICATION&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#7a4a00&quot;&gt;verifyTurn — lib/critic.ts&lt;br&gt;1 free signals → 2 small model → 3 timeout = pass&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="380" y="660" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p8" value="worked?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="765" width="140" height="70" as="geometry" />
        </mxCell>

        <mxCell id="p9" value="Stream the reply&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#666666&quot;&gt;+ TTS if voice is on&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="880" width="260" height="45" as="geometry" />
        </mxCell>

        <mxCell id="retry" value="ONE retry&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#666666&quot;&gt;feeds the reason back,&lt;br&gt;never loops twice&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="770" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="approvalNote" value="User approves or denies&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#666666&quot;&gt;cryptographically signed;&lt;br&gt;a denial is honoured and logged&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="450" width="180" height="70" as="geometry" />
        </mxCell>

