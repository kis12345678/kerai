        <mxCell id="s3" value="embeddings-index.json&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#666666&quot;&gt;semantic-search.ts — indexes code,&lt;br&gt;not conversations&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
